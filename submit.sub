universe = vanilla
executable = run_job.sh
arguments = $(method) $(rank) $(seed)

# File transfer
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = venv.tar.gz, code.tar.gz
transfer_output_remaps = "results_$(method)_r$(rank)_s$(seed).tar.gz = results/results_$(method)_r$(rank)_s$(seed).tar.gz"

# Logs
log = logs/$(method)_r$(rank)_s$(seed).log
output = logs/$(method)_r$(rank)_s$(seed).out
error = logs/$(method)_r$(rank)_s$(seed).err

# Resources
# request_memory = host RAM (not GPU). request_gpus = number of GPUs.
request_cpus = 4
request_memory = 16GB
# Unpacked venv (~7.9G gz → ~12–16G+) + code/datasets + checkpoints; 20G caused HOLD disk exceeded.
request_disk = 50GB
request_gpus = 1

# GPU VRAM (GlobalMemoryMb). Lower ⇒ more GPUs match (raise if you hit OOM).
require_gpus = (GlobalMemoryMb >= 4096)
+WantGPULab = true
+GPUJobLength = "long"

# 22 jobs only: finished FPT r2/r4 (all seeds) and FPT r8 s0/s1 are omitted (see SKIP_COMPLETED_COMBOS).
queue method,rank,seed from (
  fpt 8 2
  fpt 16 0
  fpt 16 1
  fpt 16 2
  fpt 32 0
  fpt 32 1
  fpt 32 2
  orca 2 0
  orca 2 1
  orca 2 2
  orca 4 0
  orca 4 1
  orca 4 2
  orca 8 0
  orca 8 1
  orca 8 2
  orca 16 0
  orca 16 1
  orca 16 2
  orca 32 0
  orca 32 1
  orca 32 2
)
